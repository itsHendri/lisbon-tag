---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import CalendarButton from './CalendarButton.astro';
import TileFrame from './TileFrame.astro';
import { useT, homeHref, langs, htmlLang, type Lang } from '../i18n';
import { site } from '../data/site';
import logoWhite from '../assets/brand/lisbon_tag_rugby_logo_white.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
// Until the community group link exists, Instagram is how people get in.
const whatsapp = site.links.whatsapp;
---

<TileFrame as="section" id="join" class="join" aria-labelledby="join-title" data-section>
  <div class="wrap join-inner">
    <h2 id="join-title" class="display display-md" data-split>{t.join.title}</h2>
    <p class="lede" data-reveal>{t.join.body}</p>
    {!whatsapp && <p class="join-note" data-reveal>{t.join.instagramNote}</p>}

    <div class="btn-row join-actions" data-reveal>
      {
        whatsapp ? (
          <>
            <a class="btn" href={whatsapp} target="_blank" rel="noopener">
              <Icon name="whatsapp" />
              {t.join.whatsapp}
            </a>
            <a class="btn btn--ghost sketch" href={site.links.instagram} target="_blank" rel="noopener">
              <Icon name="instagram" />
              {t.join.instagram}
            </a>
          </>
        ) : (
          <a class="btn" href={site.links.instagram} target="_blank" rel="noopener">
            <Icon name="instagram" />
            {t.join.instagramPrimary}
          </a>
        )
      }
      <CalendarButton lang={lang} ghost />
    </div>
  </div>

  <!-- The language links land on this footer in the other language, so you stay put. -->
  <footer id="footer" class="wrap">
    <div class="footer">
      <div class="footer-brand">
        <Image src={logoWhite} alt={site.name} width={200} format="webp" class="footer-logo" />
        <p class="footer-small">© {new Date().getFullYear()} {t.footer.rights}</p>
      </div>
      <div class="footer-made-wrap">
        <p class="display footer-made">{t.footer.made}</p>
        <p class="footer-small">{t.footer.tagline}</p>
      </div>
      <nav class="footer-langs" aria-label={t.nav.language}>
        {
          langs.map((l) =>
            l === lang ? (
              <span class="footer-lang is-current" aria-current="page" lang={htmlLang[l]}>
                {l.toUpperCase()}
              </span>
            ) : (
              <a class="footer-lang" href={`${homeHref(l)}#footer`} hreflang={htmlLang[l]} lang={htmlLang[l]}>
                {l.toUpperCase()}
              </a>
            ),
          )
        }
      </nav>
    </div>
  </footer>
</TileFrame>

<style>
  .join :global(.tile-frame-card) {
    padding-bottom: calc(var(--section-y) * 0.6 + var(--safe-b));
  }

  .join-inner {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .join-note {
    color: var(--fg-muted);
    max-width: 36ch;
  }

  .join-actions {
    margin-top: 0.5rem;
  }

  .footer {
    position: relative;
    margin-top: clamp(4rem, 8vw, 7rem);
    padding-top: 2rem;
    display: grid;
    gap: 2rem;
    align-items: end;
  }

  /* Hand-drawn rule above the footer. */
  .footer::before {
    content: '';
    position: absolute;
    top: -3px;
    left: 0;
    right: 0;
    height: 6px;
    background: currentColor;
    opacity: 0.6;
    -webkit-mask: var(--rule-mask) center / 100% 100% no-repeat;
    mask: var(--rule-mask) center / 100% 100% no-repeat;
  }

  :global(.footer-logo) {
    width: 6.5rem;
    height: auto;
  }

  .footer-brand,
  .footer-made-wrap {
    display: grid;
    gap: 0.75rem;
  }

  .footer-made {
    font-size: var(--display-sm);
    line-height: 1;
  }

  .footer-small {
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  /* Same EN/PT toggle as the menu. */
  .footer-langs {
    display: flex;
    gap: 3px;
    padding: 3px;
    justify-self: start;
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 2px var(--limestone);
  }

  .footer-lang {
    display: grid;
    place-items: center;
    min-width: 3.5rem;
    min-height: 2.75rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .footer-lang.is-current {
    background: var(--limestone);
    color: var(--navy);
    font-weight: 900;
  }

  a.footer-lang:hover {
    background: color-mix(in srgb, var(--limestone) 14%, transparent);
  }

  @media (min-width: 900px) {
    .footer {
      grid-template-columns: 1fr auto 1fr;
      gap: 3rem;
    }
    .footer-made-wrap {
      text-align: center;
    }
    .footer-langs {
      justify-self: end;
    }
  }
</style>
