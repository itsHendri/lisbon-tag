---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import CalendarButton from './CalendarButton.astro';
import TileFrame from './TileFrame.astro';
import { useT, homeHref, langs, type Lang } from '../i18n';
import { site } from '../data/site';
import logoWhite from '../assets/brand/lisbon_tag_rugby_logo_white.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
// Until the community group link exists, Instagram is how people get in.
const whatsapp = site.links.whatsapp;
---

<TileFrame as="section" id="join" class="join" aria-labelledby="join-title" data-section>
  <div class="wrap join-inner">
    <h2 id="join-title" class="display display-md" data-split>{t.join.title}</h2>
    <p class="lede" data-reveal>{t.join.body}</p>
    {!whatsapp && <p class="join-note" data-reveal>{t.join.instagramNote}</p>}

    <div class="btn-row join-actions" data-reveal>
      {
        whatsapp ? (
          <>
            <a class="btn" href={whatsapp} target="_blank" rel="noopener">
              <Icon name="whatsapp" />
              {t.join.whatsapp}
            </a>
            <a class="btn btn--ghost sketch" href={site.links.instagram} target="_blank" rel="noopener">
              <Icon name="instagram" />
              {t.join.instagram}
            </a>
          </>
        ) : (
          <a class="btn" href={site.links.instagram} target="_blank" rel="noopener">
            <Icon name="instagram" />
            {t.join.instagramPrimary}
          </a>
        )
      }
      <CalendarButton lang={lang} ghost />
    </div>
  </div>

  <!-- The language links land on this footer in the other language, so you stay put. -->
  <footer id="footer" class="wrap">
    <div class="footer">
      <Image src={logoWhite} alt={site.name} width={200} format="webp" class="footer-logo" />
      <div class="footer-meta">
        <p class="display footer-made">{t.footer.made}</p>
        <nav class="footer-langs" aria-label="Language">
          {
            langs.map((l) => (
              <a
                href={l === lang ? '#footer' : `${homeHref(l)}#footer`}
                aria-current={l === lang ? 'page' : undefined}
                lang={l === 'pt' ? 'pt-PT' : 'en'}>
                {l === 'en' ? 'English' : 'Português'}
              </a>
            ))
          }
        </nav>
        <p class="footer-small">© {new Date().getFullYear()} {t.footer.rights}</p>
      </div>
    </div>
  </footer>
</TileFrame>

<style>
  .join :global(.tile-frame-card) {
    padding-bottom: calc(var(--section-y) * 0.6 + var(--safe-b));
  }

  .join-inner {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .join-note {
    color: var(--fg-muted);
    max-width: 36ch;
  }

  .join-actions {
    margin-top: 0.5rem;
  }

  .footer {
    position: relative;
    margin-top: clamp(4rem, 8vw, 7rem);
    padding-top: 2rem;
    display: grid;
    gap: 2rem;
    align-items: end;
  }

  /* Hand-drawn rule above the footer. */
  .footer::before {
    content: '';
    position: absolute;
    top: -3px;
    left: 0;
    right: 0;
    height: 6px;
    background: currentColor;
    opacity: 0.6;
    -webkit-mask: var(--rule-mask) center / 100% 100% no-repeat;
    mask: var(--rule-mask) center / 100% 100% no-repeat;
  }

  :global(.footer-logo) {
    width: 7.5rem;
    height: auto;
  }

  .footer-meta {
    display: grid;
    gap: 0.75rem;
  }

  .footer-made {
    font-size: var(--display-sm);
  }

  .footer-langs {
    display: flex;
    gap: 1.25rem;
    font-weight: 700;
  }

  .footer-langs a {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    opacity: 0.7;
  }

  .footer-langs a[aria-current='page'] {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .footer-small {
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  @media (min-width: 900px) {
    .footer {
      grid-template-columns: auto 1fr;
      gap: 3rem;
    }
    .footer-meta {
      justify-items: end;
      text-align: right;
    }
  }
</style>
