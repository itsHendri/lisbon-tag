---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import CalendarButton from './CalendarButton.astro';
import TileFrame from './TileFrame.astro';
import { useT, type Lang } from '../i18n';
import { site } from '../data/site';
import castleWhite from '../assets/brand/icon_castle_white.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
// Until the community group link exists, Instagram is how people get in.
const whatsapp = site.links.whatsapp;
---

<TileFrame as="section" id="join" class="join" aria-labelledby="join-title" data-section>
  <div class="wrap join-inner">
    <h2 id="join-title" class="display display-md" data-split>{t.join.title}</h2>
    <p class="lede" data-reveal>{t.join.body}</p>
    {!whatsapp && <p class="join-note" data-reveal>{t.join.instagramNote}</p>}

    <div class="btn-row join-actions" data-reveal>
      {
        whatsapp ? (
          <>
            <a class="btn" href={whatsapp} target="_blank" rel="noopener">
              <Icon name="whatsapp" />
              {t.join.whatsapp}
            </a>
            <a class="btn btn--ghost sketch" href={site.links.instagram} target="_blank" rel="noopener">
              <Icon name="instagram" />
              {t.join.instagram}
            </a>
          </>
        ) : (
          <a class="btn" href={site.links.instagram} target="_blank" rel="noopener">
            <Icon name="instagram" />
            {t.join.instagramPrimary}
          </a>
        )
      }
      <CalendarButton lang={lang} ghost />
    </div>
  </div>

  <!-- The language switch lives in the header now, always in view. -->
  <footer class="wrap">
    <div class="footer">
      <Image src={castleWhite} alt={site.name} width={160} format="webp" class="footer-logo" />
      <div class="footer-made-wrap">
        <p class="footer-small">{t.footer.tagline}</p>
        <p class="display footer-made">{t.footer.made}</p>
      </div>
      <p class="footer-small footer-rights">© {new Date().getFullYear()} {t.footer.rights}</p>
    </div>
  </footer>
</TileFrame>

<style>
  .join :global(.tile-frame-card) {
    padding-bottom: calc(var(--section-y) * 0.6 + var(--safe-b));
  }

  .join-inner {
    display: grid;
    gap: 1.5rem;
    justify-items: center;
    text-align: center;
  }

  .join-inner .lede {
    max-width: 36ch;
  }

  .join-note {
    color: var(--fg-muted);
    max-width: 36ch;
  }

  .join-actions {
    margin-top: 0.5rem;
    justify-content: center;
  }

  .footer {
    position: relative;
    margin-top: clamp(4rem, 8vw, 7rem);
    padding-top: 2rem;
    display: grid;
    gap: 1.25rem;
    justify-items: center;
    align-items: end;
    text-align: center;
  }

  /* Hand-drawn rule above the footer. */
  .footer::before {
    content: '';
    position: absolute;
    top: -3px;
    left: 0;
    right: 0;
    height: 6px;
    background: currentColor;
    opacity: 0.6;
    -webkit-mask: var(--rule-mask) center / 100% 100% no-repeat;
    mask: var(--rule-mask) center / 100% 100% no-repeat;
  }

  :global(.footer-logo) {
    width: 5rem;
    height: auto;
  }

  .footer-made-wrap {
    display: grid;
    gap: 0.75rem;
  }

  .footer-made {
    font-size: var(--display-sm);
    line-height: 1;
  }

  .footer-small {
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  /* Wider screens: castle left, "Made in Lisbon" centred, © right. */
  @media (min-width: 900px) {
    .footer {
      grid-template-columns: 1fr auto 1fr;
      gap: 3rem;
    }
    :global(.footer-logo) {
      justify-self: start;
    }
    .footer-rights {
      justify-self: end;
    }
  }
</style>
