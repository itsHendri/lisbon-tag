---
/**
 * Full-bleed chapter break (the Quechua "Conquer new peaks" moment):
 * a photo that settles as you scroll and a huge title.
 */
import Photo from './Photo.astro';
import type { Photo as PhotoT } from '../data/photos';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  photo: PhotoT;
  title: string;
  /** Heading level, so each section keeps a sensible outline. */
  as?: 'h2' | 'h3';
  id?: string;
}

const { lang, photo, title, as: Tag = 'h2', id } = Astro.props;
---

<div class="chapter" data-zoom data-tone="dark">
  <div class="chapter-media">
    <Photo photo={photo} lang={lang} sizes="100vw" class="cover" widths={[640, 960, 1280, 1920, 2400]} />
  </div>
  <div class="chapter-scrim"></div>
  <div class="chapter-content wrap">
    <Tag id={id} class="display chapter-title" data-split>{title}</Tag>
  </div>
</div>

<style>
  .chapter {
    position: relative;
    min-height: 88svh;
    display: flex;
    align-items: flex-end;
    overflow: clip;
    color: var(--limestone);
    background: var(--navy-ink);
    isolation: isolate;
  }

  .chapter-media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .chapter-media :global(img) {
    will-change: transform;
  }

  .chapter-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--scrim-photo);
  }

  .chapter-content {
    padding-block: 8rem calc(var(--safe-b) + 6rem);
  }

  .chapter-title {
    font-size: var(--display-xl);
    max-width: 11ch;
    text-shadow: 0 4px 40px color-mix(in srgb, var(--navy-ink) 35%, transparent);
  }

  @media (min-width: 900px) {
    .chapter {
      min-height: 100svh;
    }
  }
</style>
