---
/** Small line icons, drawn on a 24px grid. Decorative unless a label is given. */
interface Props {
  name: 'play' | 'pause' | 'grid' | 'close' | 'arrow' | 'arrow-down' | 'whatsapp' | 'instagram' | 'calendar' | 'pin' | 'external' | 'plus' | 'bag';
  label?: string;
  class?: string;
}
const { name, label, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
>
  {name === 'play' && <path d="M7 4.5v15l12-7.5z" fill="currentColor" stroke="none" />}
  {name === 'pause' && (
    <>
      <rect x="6" y="4.5" width="4" height="15" rx="1" fill="currentColor" stroke="none" />
      <rect x="14" y="4.5" width="4" height="15" rx="1" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'grid' && (
    <>
      <circle cx="8" cy="8" r="1.6" fill="currentColor" stroke="none" />
      <circle cx="16" cy="8" r="1.6" fill="currentColor" stroke="none" />
      <circle cx="8" cy="16" r="1.6" fill="currentColor" stroke="none" />
      <circle cx="16" cy="16" r="1.6" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'arrow-down' && <path d="M12 5v14M6 13l6 6 6-6" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'external' && <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />}
  {name === 'pin' && (
    <>
      <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" />
      <circle cx="12" cy="9.5" r="2.5" />
    </>
  )}
  {name === 'calendar' && (
    <>
      <rect x="3.5" y="5" width="17" height="15.5" rx="2" />
      <path d="M3.5 10h17M8 3v4M16 3v4" />
    </>
  )}
  {name === 'bag' && (
    <>
      <path d="M5 8h14l-1 12.5H6z" />
      <path d="M9 10V6.5a3 3 0 0 1 6 0V10" />
    </>
  )}
  {name === 'instagram' && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'whatsapp' && (
    <>
      <path d="M4 20l1.3-4.2A8.3 8.3 0 1 1 8.4 19z" />
      <path
        d="M9.2 8.6c.2-.5.5-.5.8-.5h.5c.2 0 .4.1.5.4l.7 1.6c.1.2 0 .5-.1.6l-.5.6c-.1.1-.1.3 0 .5.6 1 1.4 1.8 2.4 2.3.2.1.4.1.5 0l.6-.6c.2-.2.4-.2.6-.1l1.6.8c.2.1.3.3.3.5 0 .6-.3 1.3-.9 1.6-.7.3-1.7.4-3.3-.4a8.7 8.7 0 0 1-3.6-3.6c-.6-1.2-.6-2.3-.1-3.1z"
        fill="currentColor"
        stroke="none"
      />
    </>
  )}
</svg>
