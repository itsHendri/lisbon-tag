---
/**
 * The fixed UI that floats over every section:
 * castle top-left, the how-to-play video pill in the middle, Menu top-right
 * (sections, the video again, and the language switch inside), plus the menu
 * and video dialogs.
 */
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { useT, homeHref, langs, htmlLang, sectionIds, type Lang } from '../i18n';
import { site } from '../data/site';
import castleMask from '../assets/brand/icon_castle_white.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const yt = site.howToPlay.youtubeId;
const castle = await getImage({ src: castleMask, width: 128, format: 'png' });
const thumb = await getImage({ src: `https://i.ytimg.com/vi/${yt}/mqdefault.jpg`, inferSize: true, width: 240, format: 'webp' });
const langNames = { en: 'English', pt: 'Português' } as const;
---

<header class="chrome-top">
  <a class="chrome-logo-wrap" href="#home" aria-label={t.nav.home}>
    <span class="chrome-logo" style={`--castle: url(${castle.src})`}></span>
  </a>

  <!-- How-to-play video, always one tap away and never over the content. -->
  <button class="film-pill" type="button" aria-haspopup="dialog" aria-controls="film" data-film-open>
    <span class="film-pill-thumb">
      <img src={thumb.src} alt="" width="64" height="36" />
      <span class="film-pill-play"><Icon name="play" /></span>
    </span>
    <span class="film-pill-text">
      <span class="film-pill-short">{t.nav.filmShort}</span>
      <span class="film-pill-long">{t.nav.film} · 4 min</span>
    </span>
  </button>

  <button class="chrome-menu" type="button" aria-haspopup="dialog" aria-controls="sheet" data-sheet-open>
    <span>{t.nav.menu}</span>
    <Icon name="grid" />
  </button>
</header>

<!-- Full-screen menu. data-lenis-prevent lets it scroll natively while the page is locked. -->
<dialog id="sheet" class="sheet theme-navy" aria-label={t.nav.menu} data-lenis-prevent>
  <div class="sheet-head">
    <span class="sheet-castle" style={`--castle: url(${castle.src})`} aria-hidden="true"></span>
    <button class="sheet-close" type="button" data-sheet-close>
      <span>{t.nav.close}</span>
      <Icon name="close" />
    </button>
  </div>

  <nav class="sheet-nav" aria-label={t.nav.sections}>
    <button class="sheet-film" type="button" aria-haspopup="dialog" aria-controls="film" data-film-open>
      <span class="sheet-film-thumb">
        <img src={thumb.src} alt="" width="240" height="135" />
        <span class="chrome-film-play"><Icon name="play" /></span>
      </span>
      <span class="chrome-film-text">
        <span class="chrome-film-title display">{t.nav.film}</span>
        <span class="chrome-film-sub">{t.nav.filmSub}</span>
      </span>
    </button>
    <ol class="sheet-list">
      {
        sectionIds.map((id, i) => (
          <li>
            <a href={`#${id}`} data-sheet-link data-section-link={id}>
              <span class="sheet-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="sheet-name display">{t.sections[id]}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="sheet-foot">
    <p class="label">{t.nav.language}</p>
    <div class="sheet-langs">
      {
        langs.map((l) =>
          l === lang ? (
            <span class="sheet-lang is-current" aria-current="page">
              {langNames[l]}
            </span>
          ) : (
            <a class="sheet-lang" href={homeHref(l)} hreflang={htmlLang[l]} lang={htmlLang[l]} data-lang-link data-base={homeHref(l)}>
              {langNames[l]}
            </a>
          ),
        )
      }
    </div>
  </div>
</dialog>

<dialog id="film" class="film" aria-label={t.nav.film}>
  <button class="film-close" type="button" data-film-close aria-label={t.nav.closeFilm}>
    <Icon name="close" />
  </button>
  <!-- The YouTube player is only created when the dialog opens (no cookies, no weight until then). -->
  <div class="film-frame" data-film-frame data-youtube={yt} data-title={t.nav.film}></div>
</dialog>

<script>
  import '../scripts/chrome';
</script>

<style>
  .chrome-top {
    position: fixed;
    top: calc(var(--safe-t) + 0.875rem);
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: max(var(--gutter), env(safe-area-inset-left));
    pointer-events: none;
  }

  .chrome-top > * {
    pointer-events: auto;
  }

  /* ---------- Castle: no plate, its colour follows what's behind it ---------- */
  .chrome-logo,
  .sheet-castle {
    display: block;
    width: 3.5rem;
    height: var(--chrome-h);
    color: var(--limestone);
    background: currentColor;
    -webkit-mask: var(--castle) center / contain no-repeat;
    mask: var(--castle) center / contain no-repeat;
    transition: color 0.3s;
  }

  /* A soft halo in the opposite colour keeps it readable over photos and tiles. */
  .chrome-logo-wrap {
    display: block;
    filter: drop-shadow(0 0 6px var(--ink-a));
    transition: filter 0.3s;
  }

  :global(html[data-chrome-tone='light']) .chrome-logo-wrap {
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--limestone) 90%, transparent));
  }

  :global(html[data-chrome-tone='light']) .chrome-logo {
    color: var(--navy);
  }

  .chrome-logo-wrap:focus-visible {
    outline-offset: 2px;
  }

  /* ---------- Menu button ---------- */
  .chrome-menu {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    min-height: var(--chrome-h);
    padding: 0 1rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--navy) 90%, transparent);
    color: var(--limestone);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--limestone) 28%, transparent),
      var(--shadow-sm);
    transition: background-color 0.25s;
  }

  .chrome-menu:hover {
    background: var(--navy);
  }

  .chrome-menu :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* ---------- How-to-play banner (Quechua's "Discover full video") ---------- */
  /* ---------- How-to-play pill ---------- */
  .film-pill {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: var(--chrome-h);
    margin-inline: auto 0.75rem;
    padding: 0.25rem 0.9rem 0.25rem 0.25rem;
    border-radius: var(--radius-pill);
    background: var(--limestone);
    color: var(--navy);
    font-size: var(--text-sm);
    font-weight: 700;
    box-shadow:
      inset 0 0 0 2px var(--navy),
      var(--shadow-sm);
  }

  .film-pill-thumb {
    position: relative;
    width: 3.6rem;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-sm);
  }

  .film-pill-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .film-pill-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--navy-deep) 35%, transparent);
    color: var(--limestone);
  }

  .film-pill-play :global(svg) {
    width: 0.75rem;
    height: 0.75rem;
  }

  .film-pill-text {
    white-space: nowrap;
  }

  .film-pill-long {
    display: none;
  }

  @media (min-width: 768px) {
    .film-pill {
      margin-inline: auto;
    }
    .film-pill-long {
      display: inline;
    }
    .film-pill-short {
      display: none;
    }
  }

  /* Menu row: thumbnail + title. */
  .chrome-film-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--navy-deep) 35%, transparent);
    color: var(--limestone);
  }

  .chrome-film-play :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    transform: translateX(1px);
    filter: drop-shadow(0 1px 3px color-mix(in srgb, var(--navy-ink) 40%, transparent));
  }

  .chrome-film-text {
    display: grid;
    gap: 0.2rem;
  }

  .chrome-film-title {
    font-size: var(--display-xs);
    line-height: 1;
    white-space: nowrap;
  }

  .chrome-film-sub {
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
  }

  /* ---------- Full-screen menu ---------- */
  .sheet {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: calc(var(--safe-t) + 0.875rem) max(var(--gutter), env(safe-area-inset-right)) calc(var(--safe-b) + 2rem)
      max(var(--gutter), env(safe-area-inset-left));
    border: 0;
    background: var(--bg);
    color: var(--fg);
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  .sheet[open] {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 4vh, 3rem);
    animation: sheet-in 0.35s var(--ease-out);
  }

  .sheet::backdrop {
    background: var(--navy);
  }

  @keyframes sheet-in {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
  }

  /* Same height and places as the header, so Close sits where Menu was. */
  .sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: none;
  }

  .sheet-close {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    min-height: var(--chrome-h);
    padding: 0 1rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--limestone) 45%, transparent);
  }

  .sheet-close :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .sheet-nav {
    max-width: 48rem;
    width: 100%;
    margin-inline: auto;
  }

  .sheet-list {
    list-style: none;
    padding: 0;
  }

  .sheet-list a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.6rem 0;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, currentColor 22%, transparent);
  }

  .sheet-list a:hover .sheet-name,
  .sheet-list a[aria-current='true'] .sheet-name {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .sheet-num {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--label-tracking);
    opacity: 0.6;
    min-width: 1.6rem;
  }

  .sheet-film {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    margin-bottom: 1rem;
    padding: 0.5rem;
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--limestone) 45%, transparent);
    text-align: left;
  }

  .sheet-film-thumb {
    position: relative;
    flex: none;
    width: 6.5rem;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-sm);
  }

  .sheet-film-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sheet-name {
    font-size: var(--display-sm);
    line-height: 1.05;
  }

  .sheet-foot {
    max-width: 48rem;
    width: 100%;
    margin: auto auto 0;
    display: grid;
    gap: 0.75rem;
  }

  .sheet-langs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .sheet-lang {
    display: grid;
    place-items: center;
    min-height: 3rem;
    border-radius: var(--radius-pill);
    font-weight: 700;
    text-decoration: none;
    box-shadow: inset 0 0 0 2px var(--limestone);
  }

  .sheet-lang.is-current {
    background: var(--limestone);
    color: var(--navy);
  }

  /* ---------- Video ---------- */
  .film {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: #000;
    color: var(--limestone);
  }

  .film[open] {
    display: grid;
    place-items: center;
  }

  .film::backdrop {
    background: #000;
  }

  .film-frame {
    width: min(100%, calc(100svh * 16 / 9));
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .film-frame :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .film-close {
    position: absolute;
    top: calc(var(--safe-t) + 0.875rem);
    right: max(var(--gutter), env(safe-area-inset-right));
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--chrome-h);
    height: var(--chrome-h);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--limestone) 18%, transparent);
  }

  .film-close :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }
</style>
