---
/**
 * The fixed UI that floats over every section:
 * castle top-left, the how-to-play video pill in the middle, Menu top-right
 * (a side panel with the language switch, the video, the sections, a small
 * map and the three ways to join), plus the video dialog.
 */
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import MapArt from './MapArt.astro';
import CalendarButton from './CalendarButton.astro';
import { useT, homeHref, langs, htmlLang, type Lang, type SectionId } from '../i18n';
import { site } from '../data/site';
import castleMask from '../assets/brand/icon_castle_white.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const yt = site.howToPlay.youtubeId;
const castle = await getImage({ src: castleMask, width: 128, format: 'png' });
const thumb = await getImage({ src: `https://i.ytimg.com/vi/${yt}/mqdefault.jpg`, inferSize: true, width: 240, format: 'webp' });
// The menu only lists the sections people jump to; the map card covers "where".
const menuIds: SectionId[] = ['how', 'outfit', 'faq'];
const th = site.thursday;
const whatsapp = site.links.whatsapp;
const other = langs.find((l) => l !== lang)!;
---

<header class="chrome-top">
  <a class="chrome-logo-wrap" href="#home" aria-label={t.nav.home}>
    <span class="chrome-logo" style={`--castle: url(${castle.src})`}></span>
  </a>

  <!-- How-to-play video, always one tap away and never over the content. -->
  <button class="film-pill sketch sketch--fill" type="button" aria-haspopup="dialog" aria-controls="film" data-film-open>
    <span class="film-pill-thumb">
      <img src={thumb.src} alt="" width="64" height="36" />
      <span class="film-pill-play"><Icon name="play" /></span>
    </span>
    <span class="film-pill-text">
      <span class="film-pill-short">{t.nav.filmShort}</span>
      <span class="film-pill-long">{t.nav.film} · 4 min</span>
    </span>
  </button>

  <!-- One control, two halves: the other language on the left, the menu on the right. -->
  <div class="chrome-actions sketch sketch--fill">
    <a
      class="chrome-lang sketch sketch--fill"
      href={homeHref(other)}
      hreflang={htmlLang[other]}
      lang={htmlLang[other]}
      aria-label={t.nav.otherLang}
      data-lang-link
      data-base={homeHref(other)}>
      {other.toUpperCase()}
    </a>
    <button class="chrome-menu sketch sketch--fill" type="button" aria-haspopup="dialog" aria-controls="sheet" data-sheet-open>
      <span>{t.nav.menu}</span>
      <Icon name="grid" />
    </button>
  </div>
</header>

<!-- Menu: a side panel on wider screens, full screen on phones. data-lenis-prevent lets it scroll natively. -->
<dialog id="sheet" class="sheet theme-navy" aria-label={t.nav.menu} data-lenis-prevent>
  <div class="sheet-head">
    <div class="sheet-langs sketch" role="group" aria-label={t.nav.language}>
      {
        langs.map((l) =>
          l === lang ? (
            <span class="sheet-lang is-current sketch sketch--fill" aria-current="page" lang={htmlLang[l]}>
              {l.toUpperCase()}
            </span>
          ) : (
            <a class="sheet-lang" href={homeHref(l)} hreflang={htmlLang[l]} lang={htmlLang[l]} data-lang-link data-base={homeHref(l)}>
              {l.toUpperCase()}
            </a>
          ),
        )
      }
    </div>
    <button class="sheet-close sketch" type="button" data-sheet-close>
      <span>{t.nav.close}</span>
      <Icon name="close" />
    </button>
  </div>

  <button class="sheet-film sketch" type="button" aria-haspopup="dialog" aria-controls="film" data-film-open>
    <span class="sheet-film-thumb">
      <img src={thumb.src} alt="" width="240" height="135" />
      <span class="chrome-film-play"><Icon name="play" /></span>
    </span>
    <span class="chrome-film-text">
      <span class="chrome-film-title">{t.nav.film}</span>
      <span class="chrome-film-sub">{t.nav.filmSub}</span>
    </span>
  </button>

  <nav class="sheet-nav" aria-label={t.nav.sections}>
    <ul class="sheet-list">
      {
        menuIds.map((id) => (
          <li>
            <a href={`#${id}`} data-sheet-link data-section-link={id} data-rule="bottom">
              {t.sections[id]}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="sheet-map">
    <!-- Both open the venue in Google Maps. -->
    <a class="sheet-map-head" href={th.mapsUrl} target="_blank" rel="noopener">
      <span>{t.sections.where}: {th.venue}</span>
      <Icon name="arrow" />
    </a>
    <a class="sheet-map-frame sketch" href={th.mapsUrl} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
      <MapArt lang={lang} compact />
    </a>
  </div>

  <!-- Same three as "See you Thursday": Instagram first and wide, the other two side by side. -->
  <div class="sheet-ctas">
    <a class="btn" href={site.links.instagram} target="_blank" rel="noopener">
      <Icon name="instagram" />
      {whatsapp ? t.join.instagram : t.join.instagramPrimary}
    </a>
    <div class:list={['sheet-cta-pair', !whatsapp && 'is-single']}>
      {
        whatsapp && (
          <a class="btn btn--ghost" href={whatsapp} target="_blank" rel="noopener">
            <Icon name="whatsapp" />
            {t.join.whatsapp}
          </a>
        )
      }
      <CalendarButton lang={lang} ghost />
    </div>
  </div>
</dialog>

<dialog id="film" class="film" aria-label={t.nav.film}>
  <button class="film-close" type="button" data-film-close aria-label={t.nav.closeFilm}>
    <Icon name="close" />
  </button>
  <!-- The YouTube player is only created when the dialog opens (no cookies, no weight until then). -->
  <div class="film-frame" data-film-frame data-youtube={yt} data-title={t.nav.film}></div>
</dialog>

<script>
  import '../scripts/chrome';
</script>

<style>
  .chrome-top {
    position: fixed;
    top: calc(var(--safe-t) + 0.875rem);
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: max(var(--gutter), env(safe-area-inset-left)) max(var(--gutter), env(safe-area-inset-right));
    pointer-events: none;
  }

  .chrome-top > * {
    pointer-events: auto;
  }

  /* ---------- Castle: no plate, its colour follows what's behind it ---------- */
  .chrome-logo {
    display: block;
    width: 3.5rem;
    height: var(--chrome-h);
    color: var(--limestone);
    background: currentColor;
    -webkit-mask: var(--castle) center / contain no-repeat;
    mask: var(--castle) center / contain no-repeat;
    transition: color 0.3s;
  }

  /* A soft halo in the opposite colour keeps it readable over photos and tiles. */
  .chrome-logo-wrap {
    display: block;
    filter: drop-shadow(0 0 6px var(--ink-a));
    transition: filter 0.3s;
  }

  :global(html[data-chrome-tone='light']) .chrome-logo-wrap {
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--limestone) 90%, transparent));
  }

  :global(html[data-chrome-tone='light']) .chrome-logo {
    color: var(--navy);
  }

  .chrome-logo-wrap:focus-visible {
    outline-offset: 2px;
  }

  /* ---------- Language + Menu, one joined control ---------- */
  .chrome-actions {
    flex: none;
    display: flex;
    align-items: stretch;
    min-height: var(--chrome-h);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--navy) 90%, transparent);
    color: var(--limestone);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--limestone) 28%, transparent),
      var(--shadow-sm);
    /* Drawn: solid navy fill, solid limestone line (sketch--fill). */
    --sketch-inset: 0px;
    --sketch-w: 1.5px;
    --sketch-fill: var(--navy);
    --sketch-color: var(--limestone);
  }

  /* Each half has its own drawn shape, empty until you point at it: then it
     fills in limestone a little inside the line, with navy text. */
  .chrome-lang,
  .chrome-menu {
    display: inline-flex;
    align-items: center;
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    transition: color 0.2s;
    --sketch-inset: 4px;
    --sketch-w: 1.5px;
    --sketch-fill: transparent;
    --sketch-color: transparent;
  }

  .chrome-lang > :global(.sketch-svg rect),
  .chrome-menu > :global(.sketch-svg rect) {
    transition:
      fill 0.2s,
      stroke 0.2s;
  }

  @media (hover: hover) {
    .chrome-lang:hover,
    .chrome-menu:hover {
      color: var(--navy);
      --sketch-fill: var(--limestone);
      --sketch-color: var(--limestone);
    }
  }

  .chrome-lang:focus-visible,
  .chrome-menu:focus-visible {
    color: var(--navy);
    --sketch-fill: var(--limestone);
    --sketch-color: var(--limestone);
  }

  .chrome-lang {
    justify-content: center;
    min-width: 2.9rem;
    padding: 0 0.75rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-decoration: none;
    border-right: 1px solid color-mix(in srgb, var(--limestone) 70%, transparent);
  }

  .chrome-menu {
    gap: 1rem;
    padding: 0 1rem;
    font-weight: 700;
  }

  .chrome-menu > :global(svg:not(.sketch-svg)) {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
  }

  /* ---------- How-to-play banner (Quechua's "Discover full video") ---------- */
  /* ---------- How-to-play pill ---------- */
  .film-pill {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: var(--chrome-h);
    margin-inline: auto 0.75rem;
    padding: 0.25rem 0.9rem 0.25rem 0.25rem;
    border-radius: var(--radius-pill);
    background: var(--limestone);
    color: var(--navy);
    font-size: var(--text-sm);
    font-weight: 700;
    box-shadow:
      inset 0 0 0 2px var(--navy),
      var(--shadow-sm);
    /* Drawn: limestone fill, navy line (sketch--fill). */
    --sketch-inset: 0px;
    --sketch-w: 2px;
    --sketch-fill: var(--limestone);
    --sketch-color: var(--navy);
  }

  .film-pill-thumb {
    position: relative;
    width: 3.6rem;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-sm);
  }

  .film-pill-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .film-pill-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--navy-deep) 35%, transparent);
    color: var(--limestone);
  }

  .film-pill-play :global(svg) {
    width: 0.75rem;
    height: 0.75rem;
  }

  .film-pill-text {
    white-space: nowrap;
  }

  .film-pill-long {
    display: none;
  }

  @media (min-width: 768px) {
    .film-pill {
      margin-inline: auto;
      transition:
        opacity 0.3s,
        transform 0.4s var(--ease-out),
        visibility 0.4s;
    }
    /* On bigger screens it's only in the way once you're reading; it stays in the menu. */
    :global(html[data-scrolled]) .film-pill {
      opacity: 0;
      visibility: hidden;
      transform: translateY(-140%);
    }
    .film-pill-long {
      display: inline;
    }
    .film-pill-short {
      display: none;
    }
  }

  /* Phones: castle, video pill, language and menu all fit on one line, with even
     side padding. These come after the pill rules so they win. */
  @media (max-width: 419px) {
    .chrome-logo {
      width: 2.75rem;
    }
    .film-pill {
      margin-inline: auto 0.5rem;
    }
    .film-pill-thumb {
      width: 2.8rem;
    }
  }

  @media (max-width: 389px) {
    .film-pill {
      gap: 0.45rem;
      margin-inline: auto 0.4rem;
      padding-right: 0.7rem;
    }
    .chrome-menu {
      gap: 0.6rem;
      padding: 0 0.75rem;
    }
    .chrome-lang {
      min-width: 2.6rem;
      padding: 0 0.6rem;
    }
  }

  /* The smallest phones: Menu is icon-only, the word stays for screen readers. */
  @media (max-width: 349px) {
    .chrome-menu {
      min-width: var(--chrome-h);
      justify-content: center;
    }
    .chrome-menu span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* Menu row: thumbnail + title. */
  .chrome-film-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--navy-deep) 35%, transparent);
    color: var(--limestone);
  }

  .chrome-film-play :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    transform: translateX(1px);
    filter: drop-shadow(0 1px 3px color-mix(in srgb, var(--navy-ink) 40%, transparent));
  }

  .chrome-film-text {
    display: grid;
    gap: 0.2rem;
  }

  .chrome-film-title {
    font-size: var(--text-lg);
    font-weight: 900;
    line-height: 1.1;
    white-space: nowrap;
  }

  .chrome-film-sub {
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
  }

  /* ---------- Menu panel ---------- */
  .sheet {
    position: fixed;
    inset: 0 0 0 auto;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: calc(var(--safe-t) + 0.875rem) max(var(--gutter), env(safe-area-inset-right)) calc(var(--safe-b) + 1.5rem)
      max(var(--gutter), env(safe-area-inset-left));
    border: 0;
    background: var(--bg);
    color: var(--fg);
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  .sheet[open] {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    animation: sheet-in 0.35s var(--ease-out);
  }

  .sheet.no-anim {
    animation: none;
  }

  .sheet::backdrop {
    background: color-mix(in srgb, var(--navy-ink) 60%, transparent);
  }

  @keyframes sheet-in {
    from {
      opacity: 0;
      transform: translateX(24px);
    }
  }

  @media (min-width: 768px) {
    .sheet {
      width: min(30rem, 100%);
      padding-inline: 2.25rem;
      box-shadow: -20px 0 60px var(--ink-a);
    }
  }

  /* Same height as the header, so Close sits where Menu was. */
  .sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex: none;
  }

  .sheet-close {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    min-height: var(--chrome-h);
    padding: 0 1rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    --sketch-inset: 0px;
    --sketch-w: 1.5px;
    --sketch-color: color-mix(in srgb, var(--limestone) 70%, transparent);
  }

  .sheet-close > :global(svg:not(.sketch-svg)) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .sheet-langs {
    display: flex;
    gap: 3px;
    padding: 3px;
    border-radius: var(--radius-pill);
    --sketch-inset: 0px;
    --sketch-w: 1.5px;
    --sketch-color: color-mix(in srgb, var(--limestone) 70%, transparent);
  }

  .sheet-lang {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: calc(var(--chrome-h) - 6px);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .sheet-lang.is-current {
    background: var(--limestone);
    color: var(--navy);
    font-weight: 900;
    --sketch-inset: 0px;
    --sketch-w: 1.5px;
    --sketch-fill: var(--limestone);
    --sketch-color: var(--limestone);
  }

  .sheet-lang:not(.is-current):hover {
    background: color-mix(in srgb, var(--limestone) 14%, transparent);
  }

  .sheet-film {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 0.5rem;
    border-radius: var(--radius);
    text-align: left;
    --sketch-w: 2px;
    --sketch-color: color-mix(in srgb, var(--limestone) 70%, transparent);
  }

  .sheet-film-thumb {
    position: relative;
    flex: none;
    width: 6.5rem;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-sm);
  }

  .sheet-film-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sheet-list {
    list-style: none;
    padding: 0;
  }

  /* A hand-drawn line under each section (data-rule), like the FAQ. */
  .sheet-list a {
    --rule-opacity: 0.45;
    display: block;
    padding: 0.7rem 0;
    font-size: var(--text-xl);
    font-weight: 900;
    line-height: 1.15;
    text-decoration: none;
  }

  .sheet-list a:hover,
  .sheet-list a[aria-current='true'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  /* ---------- Map card ---------- */
  .sheet-map {
    display: grid;
    gap: 0.6rem;
  }

  .sheet-map-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    font-size: 1.0625rem;
    font-weight: 900;
    text-decoration: none;
  }

  .sheet-map-head :global(svg) {
    width: 1em;
    height: 1em;
  }

  /* A skinny strip, so all three buttons fit on a laptop screen. */
  .sheet-map-frame {
    position: relative;
    display: block;
    height: 9.5rem;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--limestone);
    --sketch-color: var(--limestone);
    --sketch-w: 2px;
  }

  .sheet-ctas {
    flex: none;
    display: grid;
    gap: 0.625rem;
    margin-top: auto;
  }

  .sheet-ctas :global(.btn) {
    width: 100%;
  }

  .sheet-cta-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.625rem;
  }

  .sheet-cta-pair :global(.btn) {
    padding-inline: 0.75rem;
    font-size: var(--text-sm);
  }

  .sheet-cta-pair.is-single {
    grid-template-columns: 1fr;
  }

  /* Too narrow for two labels side by side. */
  @media (max-width: 379px) {
    .sheet-cta-pair {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Video ---------- */
  .film {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: #000;
    color: var(--limestone);
  }

  .film[open] {
    display: grid;
    place-items: center;
  }

  .film::backdrop {
    background: #000;
  }

  .film-frame {
    width: min(100%, calc(100svh * 16 / 9));
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .film-frame :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .film-close {
    position: absolute;
    top: calc(var(--safe-t) + 0.875rem);
    right: max(var(--gutter), env(safe-area-inset-right));
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--chrome-h);
    height: var(--chrome-h);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--limestone) 18%, transparent);
  }

  .film-close :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }
</style>
