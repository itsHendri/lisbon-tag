---
/**
 * One photo from src/data/photos.ts, resized and converted by Astro at build
 * time: AVIF where the browser has it (about a third smaller), WebP otherwise.
 */
import { Picture } from 'astro:assets';
import type { Photo } from '../data/photos';
import type { Lang } from '../i18n';

interface Props {
  photo: Photo;
  lang: Lang;
  /** The rendered width at each breakpoint, so phones get small files. */
  sizes: string;
  class?: string;
  priority?: boolean;
  widths?: number[];
  [key: `data-${string}`]: string | undefined;
}

const { photo, lang, sizes, class: className, priority = false, widths = [320, 480, 768, 1080, 1440, 1920], ...rest } = Astro.props;

const common = {
  alt: photo.alt[lang],
  sizes,
  widths,
  class: className,
  style: photo.position ? `object-position: ${photo.position}` : undefined,
  priority,
  formats: ['avif', 'webp'] as ('avif' | 'webp')[],
  fallbackFormat: 'webp' as const,
  quality: 52,
  ...rest,
};
---

{typeof photo.src === 'string' ? <Picture src={photo.src} inferSize {...common} /> : <Picture src={photo.src} {...common} />}
