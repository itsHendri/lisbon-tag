---
/** One photo from src/data/photos.ts, resized and converted by Astro at build time. */
import { Image } from 'astro:assets';
import type { Photo } from '../data/photos';
import type { Lang } from '../i18n';

interface Props {
  photo: Photo;
  lang: Lang;
  /** The rendered width at each breakpoint, so phones get small files. */
  sizes: string;
  class?: string;
  priority?: boolean;
  widths?: number[];
  [key: `data-${string}`]: string | undefined;
}

const { photo, lang, sizes, class: className, priority = false, widths = [480, 768, 1080, 1440, 1920], ...rest } = Astro.props;

const common = {
  alt: photo.alt[lang],
  sizes,
  widths,
  class: className,
  style: photo.position ? `object-position: ${photo.position}` : undefined,
  priority,
  format: 'webp' as const,
  quality: 72,
  ...rest,
};
---

{typeof photo.src === 'string' ? <Image src={photo.src} inferSize {...common} /> : <Image src={photo.src} {...common} />}
