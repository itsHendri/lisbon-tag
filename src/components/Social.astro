---
import { getImage } from 'astro:assets';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import TileFrame from './TileFrame.astro';
import { useT, type Lang } from '../i18n';
import { photos } from '../data/photos';
import { site } from '../data/site';
import tileBlue from '../assets/brand/tile_blue.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const tile = await getImage({ src: tileBlue, width: 240, format: 'webp' });
---

<TileFrame as="section" tone="granite" id="social" aria-labelledby="social-title" data-section>
  <div class="wrap">
    <header class="social-head">
      <h2 id="social-title" class="display display-md" data-split>{t.social.title}</h2>
      <p class="lede" data-reveal>{t.social.body}</p>
    </header>

    <ul class="gallery" data-reveal-stagger>
      {
        photos.gallery.map((p, i) => (
          <li class:list={['gallery-item frame', `g${i % 8}`]}>
            <Photo photo={p} lang={lang} sizes="(min-width: 900px) 25vw, 50vw" widths={[400, 640, 960]} class="cover" />
          </li>
        ))
      }
      <!-- Instagram is the last tile in the grid, framed in azulejos like the dark panels. -->
      <li class="gallery-item gallery-insta tiles" style={`--tile-url: url(${tile.src})`}>
        <a class="insta-card sketch theme-navy" data-tone="dark" href={site.links.instagram} target="_blank" rel="noopener">
          <Icon name="instagram" />
          <span class="insta-text">
            <span class="insta-cta">{t.social.cta}</span>
            <span class="insta-handle">{site.links.instagramHandle}</span>
          </span>
        </a>
      </li>
    </ul>
  </div>
</TileFrame>

<style>
  /* Same space on all four sides of the panel, at every screen width. */
  :global(#social > .tile-frame-card) {
    padding-block: var(--side);
  }

  .social-head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .gallery {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: clamp(7rem, 22vw, 12rem);
    grid-auto-flow: dense;
    gap: 0.6rem;
  }

  /* A rhythm of tall and wide frames, like a camera roll. */
  .g0,
  .g5 {
    grid-row: span 2;
  }
  .g3,
  .g7 {
    grid-column: span 2;
  }

  .gallery-insta {
    grid-column: span 2;
    padding: clamp(0.75rem, 1.4vw, 1.1rem);
    --tile-size: 64px;
  }

  @media (min-width: 900px) {
    .gallery {
      grid-template-columns: repeat(4, 1fr);
      gap: 0.9rem;
    }
    .g3 {
      grid-column: span 2;
      grid-row: span 2;
    }
    /* The last photo and the Instagram tile share the bottom row. */
    .g7 {
      grid-column: span 3;
      grid-row: span 2;
    }
    .gallery-insta {
      grid-column: span 1;
      grid-row: span 2;
    }
  }

  .insta-card {
    height: 100%;
    min-height: 9rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1.25rem, 2.4vw, 1.75rem);
    background: var(--background);
    --sketch-inset: 0.5rem;
    --sketch-w: 2px;
    --sketch-color: var(--stroke);
    color: var(--foreground);
    outline: 3px solid var(--background);
    text-decoration: none;
    transition: background-color 0.25s;
  }

  .insta-card:hover {
    background: var(--card);
  }

  .insta-card > :global(svg:not(.sketch-svg)) {
    width: 2.25rem;
    height: 2.25rem;
  }

  .insta-text {
    display: grid;
    gap: 0.35rem;
  }

  .insta-cta {
    font-family: var(--font-display);
    font-size: var(--display-xs);
    line-height: 1;
  }

  .insta-handle {
    font-weight: 700;
    font-size: var(--text-sm);
  }
</style>
