---
/**
 * Hero: a slow crossfade through club photos (photos.hero) until there's a
 * club video. Pausable; with reduced motion it stays on the first photo.
 */
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { useT, type Lang } from '../i18n';
import { photos } from '../data/photos';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<section id="home" class="hero theme-navy" data-section data-hero data-tone="dark" aria-labelledby="hero-title">
  <div class="hero-media" data-hero-slides>
    {
      photos.hero.map((p, i) => (
        <div class:list={['hero-slide', i === 0 && 'is-active']} aria-hidden={i === 0 ? undefined : 'true'}>
          <Photo photo={p} lang={lang} sizes="100vw" widths={[640, 960, 1280, 1920]} class="cover" priority={i === 0} />
        </div>
      ))
    }
    <div class="hero-scrim"></div>
  </div>

  <div class="hero-content wrap" data-hero-content>
    <h1 id="hero-title" class="display hero-title" data-hero-in>
      <span>Lisbon Tag</span>
      <span>Rugby</span>
    </h1>
    <span class="rule hero-rule" data-hero-in></span>
    <div class="hero-foot" data-hero-in>
      <p class="hero-sub">{t.hero.sub}</p>
      <a class="btn" href="#thursdays">
        {t.hero.join}
        <Icon name="arrow" />
      </a>
    </div>

  </div>

  <button class="hero-toggle" type="button" data-hero-toggle aria-pressed="false" data-label-pause={t.hero.pause} data-label-play={t.hero.play}>
    <span class="hero-toggle-pause"><Icon name="pause" /></span>
    <span class="hero-toggle-play"><Icon name="play" /></span>
    <span class="sr-only" data-hero-toggle-label>{t.hero.pause}</span>
  </button>
</section>

<script>
  import { prefersReducedMotion } from '../scripts/scroll';

  const slides = [...document.querySelectorAll<HTMLElement>('.hero-slide')];
  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');
  const toggleLabel = toggle?.querySelector<HTMLElement>('[data-hero-toggle-label]');
  const HOLD = 6000;

  let index = 0;
  let timer: number | undefined;
  // Only the visitor (or reduced motion) pauses it; it also rests while off screen.
  let userPaused = prefersReducedMotion();
  let onScreen = true;

  function show(next: number) {
    slides[index].classList.remove('is-active');
    index = next % slides.length;
    slides[index].classList.add('is-active');
  }

  function sync() {
    window.clearInterval(timer);
    const running = !userPaused && onScreen && document.visibilityState === 'visible' && slides.length > 1;
    if (running) timer = window.setInterval(() => show(index + 1), HOLD);
    document.querySelector('[data-hero-slides]')?.classList.toggle('is-paused', !running);
    if (!toggle) return;
    toggle.setAttribute('aria-pressed', String(userPaused));
    toggle.classList.toggle('is-paused', userPaused);
    if (toggleLabel) toggleLabel.textContent = userPaused ? toggle.dataset.labelPlay! : toggle.dataset.labelPause!;
  }

  toggle?.addEventListener('click', () => {
    userPaused = !userPaused;
    sync();
  });

  const hero = document.querySelector('[data-hero]');
  if (hero) {
    new IntersectionObserver(([e]) => {
      onScreen = e.isIntersecting;
      sync();
    }).observe(hero);
  }
  document.addEventListener('visibilitychange', sync);
  sync();
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: clip;
    background: var(--navy-ink);
    color: var(--limestone);
    isolation: isolate;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* Crossfade, with a slow push-in on the photo that's showing. */
  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.6s ease-in-out;
  }

  .hero-slide.is-active {
    opacity: 1;
  }

  .hero-slide :global(img) {
    transform: scale(1.08);
    transition: transform 7.5s linear;
  }

  .hero-slide.is-active :global(img) {
    transform: scale(1);
  }

  .hero-media.is-paused .hero-slide :global(img) {
    transition: none;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      var(--scrim-top),
      linear-gradient(
        0deg,
        color-mix(in srgb, var(--navy-deep) 95%, transparent) 0%,
        color-mix(in srgb, var(--navy) 55%, transparent) 42%,
        transparent 75%
      );
  }

  .hero-content {
    padding-bottom: calc(var(--safe-b) + 3rem);
    padding-top: 7rem;
  }

  .hero-title {
    font-size: var(--display-xl);
    display: flex;
    flex-direction: column;
    text-shadow: 0 4px 40px var(--ink-a);
  }

  .hero-rule {
    margin-block: clamp(1.25rem, 3vw, 2rem);
    max-width: 46rem;
  }

  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    max-width: 46rem;
  }

  .hero-sub {
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.2;
    max-width: 20ch;
  }

  .hero-toggle {
    position: absolute;
    top: calc(var(--safe-t) + 4.25rem);
    right: max(var(--gutter), env(safe-area-inset-right));
    display: grid;
    place-items: center;
    width: var(--chrome-h);
    height: var(--chrome-h);
    border-radius: var(--radius);
    color: var(--limestone);
    background: color-mix(in srgb, var(--limestone) 16%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .hero-toggle :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
  }

  .hero-toggle-play,
  .hero-toggle.is-paused .hero-toggle-pause {
    display: none;
  }

  .hero-toggle.is-paused .hero-toggle-play {
    display: block;
  }

  @media (min-width: 900px) {
    .hero-content {
      padding-bottom: 5rem;
    }
  }
</style>
