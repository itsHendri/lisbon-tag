---
/**
 * Hero: a slow crossfade through club photos (photos.hero) until there's a
 * club video. With reduced motion it stays on the first photo.
 */
import CalendarButton from './CalendarButton.astro';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { useT, type Lang } from '../i18n';
import { photos } from '../data/photos';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const th = site.thursday;
---

<section id="home" class="hero theme-navy" data-section data-hero data-tone="dark" aria-labelledby="hero-title">
  <div class="hero-media" data-hero-slides>
    {
      photos.hero.map((p, i) => (
        <div class:list={['hero-slide', i === 0 && 'is-active']} aria-hidden={i === 0 ? undefined : 'true'}>
          <Photo photo={p} lang={lang} sizes="100vw" widths={[640, 960, 1280, 1920]} class="cover" priority={i === 0} />
        </div>
      ))
    }
    <div class="hero-scrim"></div>
  </div>

  <div class="hero-content wrap" data-hero-content>
    <!-- Name, one line and the buttons up top; the Thursday facts along the bottom of the photo. -->
    <div class="hero-top">
      <h1 id="hero-title" class="display hero-title" data-hero-in>
        <span>Lisbon Tag</span>
        <span>Rugby</span>
      </h1>
      <p class="hero-sub" data-hero-in>{t.hero.sub}</p>
      <div class="hero-actions" data-hero-in>
        <CalendarButton lang={lang} />
        <a class="btn btn--ghost hero-directions" href={th.mapsUrl} target="_blank" rel="noopener">
          <Icon name="pin" />
          {t.actions.directions}
        </a>
      </div>
    </div>

    <div class="hero-bottom" data-hero-in>
      <span class="rule hero-rule"></span>
      <dl class="hero-facts">
        <div>
          <dt class="label">{t.hero.labels.when}</dt>
          <dd>{t.hero.day}, {th.start}</dd>
        </div>
        <div>
          <dt class="label">{t.hero.labels.where}</dt>
          <dd><a href={th.mapsUrl} target="_blank" rel="noopener">{th.venue.split(',')[0]}</a></dd>
        </div>
        <div>
          <dt class="label">{t.hero.labels.cost}</dt>
          <dd>{t.hero.cost}</dd>
        </div>
        <div>
          <dt class="label">{t.hero.labels.level}</dt>
          <dd>{t.facts.level}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<script>
  import { prefersReducedMotion } from '../scripts/scroll';

  const slides = [...document.querySelectorAll<HTMLElement>('.hero-slide')];
  const HOLD = 6000;

  let index = 0;
  let timer: number | undefined;
  // Still with reduced motion; it also rests while off screen or in a background tab.
  const still = prefersReducedMotion();
  let onScreen = true;

  function show(next: number) {
    slides[index].classList.remove('is-active');
    index = next % slides.length;
    slides[index].classList.add('is-active');
  }

  function sync() {
    window.clearInterval(timer);
    const running = !still && onScreen && document.visibilityState === 'visible' && slides.length > 1;
    if (running) timer = window.setInterval(() => show(index + 1), HOLD);
    document.querySelector('[data-hero-slides]')?.classList.toggle('is-paused', !running);
  }

  const hero = document.querySelector('[data-hero]');
  if (hero) {
    new IntersectionObserver(([e]) => {
      onScreen = e.isIntersecting;
      sync();
    }).observe(hero);
  }
  document.addEventListener('visibilitychange', sync);
  sync();
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: clip;
    background: var(--navy-ink);
    color: var(--limestone);
    isolation: isolate;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* Crossfade, with a slow push-in on the photo that's showing. */
  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.6s ease-in-out;
  }

  .hero-slide.is-active {
    opacity: 1;
  }

  .hero-slide :global(img) {
    transform: scale(1.08);
    transition: transform 7.5s linear;
  }

  .hero-slide.is-active :global(img) {
    transform: scale(1);
  }

  .hero-media.is-paused .hero-slide :global(img) {
    transition: none;
  }

  /* Dark at the top for the title, and at the bottom for the facts. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--navy-ink) 85%, transparent) 0%,
      color-mix(in srgb, var(--navy-ink) 35%, transparent) 40%,
      color-mix(in srgb, var(--navy-ink) 25%, transparent) 60%,
      color-mix(in srgb, var(--navy-ink) 88%, transparent) 100%
    );
  }

  .hero-content {
    flex: 1;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: calc(var(--safe-t) + 5.5rem);
    padding-bottom: calc(var(--safe-b) + 1.75rem);
  }

  .hero-top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1rem, 2vw, 1.4rem);
  }

  .hero-title {
    font-size: clamp(4.75rem, 2.7rem + 8.3vw, 11rem);
    display: flex;
    flex-direction: column;
    text-shadow: 0 4px 40px var(--ink-a);
  }

  .hero-sub {
    max-width: 30ch;
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.35;
    text-shadow: 0 2px 16px var(--ink-a);
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    padding-top: 0.4rem;
  }

  /* See-through outline over the photo, so the drawn line reads. */
  .hero-directions {
    --btn-fill: color-mix(in srgb, var(--navy-ink) 35%, transparent);
  }

  .hero-bottom {
    margin-top: auto;
  }

  .hero-facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 1rem;
  }

  .hero-facts > div {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.85rem 0 0.6rem;
  }

  .hero-facts dt {
    font-size: var(--text-xs);
    opacity: 0.85;
  }

  .hero-facts dd {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1rem + 1.6vw, 2.4rem);
    line-height: 1;
  }

  .hero-facts a {
    text-decoration: none;
  }

  .hero-facts a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }

  /* Phones: the facts come first, then the one button that matters most.
     The venue fact links to the map, so directions isn't lost. */
  @media (max-width: 639px) {
    .hero-top {
      display: contents;
    }
    .hero-title,
    .hero-sub {
      order: -1;
    }
    .hero-actions {
      order: 1;
      width: 100%;
      padding-top: 0.25rem;
    }
    .hero-directions {
      display: none;
    }
  }

  @media (min-width: 900px) {
    .hero-content {
      gap: 2.5rem;
      padding-top: 7.5rem;
      padding-bottom: 2.75rem;
    }
    .hero-sub {
      font-size: var(--text-xl);
    }
    .hero-facts {
      grid-template-columns: 1fr 1.5fr 0.7fr 1.2fr;
      gap: 0 2rem;
    }
    .hero-facts > div {
      gap: 0.5rem;
      padding-top: 1.1rem;
    }
    .hero-facts dt {
      font-size: var(--text-sm);
    }
  }
</style>
