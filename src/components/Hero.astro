---
/**
 * Hero: a slow crossfade through club photos (photos.hero) until there's a
 * club video. With reduced motion it stays on the first photo.
 */
import CalendarButton from './CalendarButton.astro';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { useT, type Lang } from '../i18n';
import { photos } from '../data/photos';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const th = site.thursday;
---

<section id="home" class="hero theme-navy" data-section data-hero data-tone="dark" aria-labelledby="hero-title">
  <div class="hero-media" data-hero-slides>
    {
      photos.hero.map((p, i) => (
        <div class:list={['hero-slide', i === 0 && 'is-active']} aria-hidden={i === 0 ? undefined : 'true'}>
          <Photo photo={p} lang={lang} sizes="100vw" widths={[640, 960, 1280, 1920]} class="cover" priority={i === 0} />
        </div>
      ))
    }
    <div class="hero-scrim"></div>
  </div>

  <div class="hero-content wrap" data-hero-content>
    <h1 id="hero-title" class="display hero-title" data-hero-in>
      <span>Lisbon Tag</span>
      <span>Rugby</span>
    </h1>
    <span class="rule hero-rule" data-hero-in></span>
    <!-- Everything you need for a first Thursday, before you scroll. -->
    <div class="hero-foot" data-hero-in>
      <ul class="hero-facts">
        <li><Icon name="calendar" />{t.facts.day}, {th.start}</li>
        <li><Icon name="pin" />{th.venue}</li>
        <li><Icon name="heart" />{t.hero.free}</li>
      </ul>
      <div class="hero-actions">
        <a class="btn btn--ghost hero-directions" href={th.mapsUrl} target="_blank" rel="noopener">
          <Icon name="pin" />
          {t.actions.directions}
        </a>
        <CalendarButton lang={lang} />
      </div>
    </div>
  </div>
</section>

<script>
  import { prefersReducedMotion } from '../scripts/scroll';

  const slides = [...document.querySelectorAll<HTMLElement>('.hero-slide')];
  const HOLD = 6000;

  let index = 0;
  let timer: number | undefined;
  // Still with reduced motion; it also rests while off screen or in a background tab.
  const still = prefersReducedMotion();
  let onScreen = true;

  function show(next: number) {
    slides[index].classList.remove('is-active');
    index = next % slides.length;
    slides[index].classList.add('is-active');
  }

  function sync() {
    window.clearInterval(timer);
    const running = !still && onScreen && document.visibilityState === 'visible' && slides.length > 1;
    if (running) timer = window.setInterval(() => show(index + 1), HOLD);
    document.querySelector('[data-hero-slides]')?.classList.toggle('is-paused', !running);
  }

  const hero = document.querySelector('[data-hero]');
  if (hero) {
    new IntersectionObserver(([e]) => {
      onScreen = e.isIntersecting;
      sync();
    }).observe(hero);
  }
  document.addEventListener('visibilitychange', sync);
  sync();
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: clip;
    background: var(--navy-ink);
    color: var(--limestone);
    isolation: isolate;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* Crossfade, with a slow push-in on the photo that's showing. */
  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.6s ease-in-out;
  }

  .hero-slide.is-active {
    opacity: 1;
  }

  .hero-slide :global(img) {
    transform: scale(1.08);
    transition: transform 7.5s linear;
  }

  .hero-slide.is-active :global(img) {
    transform: scale(1);
  }

  .hero-media.is-paused .hero-slide :global(img) {
    transition: none;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      var(--scrim-top),
      linear-gradient(
        0deg,
        color-mix(in srgb, var(--navy-deep) 95%, transparent) 0%,
        color-mix(in srgb, var(--navy) 55%, transparent) 42%,
        transparent 75%
      );
  }

  .hero-content {
    padding-bottom: calc(var(--safe-b) + 3rem);
    padding-top: 7rem;
  }

  .hero-title {
    font-size: var(--display-xl);
    display: flex;
    flex-direction: column;
    text-shadow: 0 4px 40px var(--ink-a);
  }

  .hero-rule {
    margin-block: clamp(1.25rem, 3vw, 2rem);
  }

  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .hero-facts {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2rem;
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.25;
    text-shadow: 0 2px 16px var(--ink-a);
  }

  .hero-facts li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hero-facts :global(svg) {
    width: 1.25em;
    height: 1.25em;
    flex: none;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
  }

  /* See-through outline over the photo, so the drawn line reads. */
  .hero-directions {
    --btn-fill: color-mix(in srgb, var(--navy-ink) 35%, transparent);
  }

  /* One row with the buttons on a laptop; bigger again on wide screens. */
  @media (min-width: 900px) {
    .hero-facts {
      font-size: 1.125rem;
      column-gap: 1.75rem;
    }
  }

  @media (min-width: 1440px) {
    .hero-facts {
      font-size: var(--text-lg);
    }
  }

  @media (max-width: 639px) {
    .hero-facts {
      flex-direction: column;
    }
    .hero-actions {
      flex-direction: column-reverse;
      width: 100%;
    }
  }

  @media (min-width: 900px) {
    .hero-content {
      padding-bottom: 5rem;
    }
  }
</style>
