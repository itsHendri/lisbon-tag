---
import BeachTag from './BeachTag.astro';
import Icon from './Icon.astro';
import { useT, type Lang } from '../i18n';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const th = site.thursday;
---

<section id="where" class="section theme-light where" data-section aria-labelledby="where-title">
  <div class="wrap where-grid">
    <header class="where-head">
      <h2 id="where-title" class="display display-md" data-split>{t.where.title}</h2>
      <p class="where-venue">{th.venue}</p>
      <p class="lede" data-reveal>{t.where.body}</p>
      <p class="where-meta" data-reveal>
        <span><Icon name="pin" /> {t.where.transport}</span>
      </p>
    </header>

    <!--
      Google's embed can't be restyled from outside, so the brand look is two
      blend layers over a greyscale map: dark becomes navy, light becomes
      limestone. They let clicks through, so the map still pans and zooms.
    -->
    <div class="map map-tinted frame sketch" data-reveal>
      <iframe
        src={th.mapsEmbed}
        title={t.where.mapTitle}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
      <span class="map-tint map-tint--dark" aria-hidden="true"></span>
      <span class="map-tint map-tint--light" aria-hidden="true"></span>
    </div>
  </div>

  <div class="wrap where-beach">
    <BeachTag lang={lang} />
  </div>
</section>

<style>
  .where-grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .where-head {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .where-venue {
    font-size: var(--text-xl);
    font-weight: 900;
    line-height: 1.2;
  }

  .where-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-weight: 700;
  }

  .where-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .where-meta :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }

  /* ---------- Map ---------- */
  .map {
    min-height: 24rem;
    --sketch-color: var(--navy);
  }

  .where-beach {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  @media (min-width: 960px) {
    .where-grid {
      grid-template-columns: 1fr 1.25fr;
      align-items: center;
    }
    .map {
      min-height: 30rem;
    }
  }
</style>
