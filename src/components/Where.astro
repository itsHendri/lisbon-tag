---
import Icon from './Icon.astro';
import MapArt from './MapArt.astro';
import { useT, type Lang } from '../i18n';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const th = site.thursday;
---

<section id="where" class="section theme-light where" data-section aria-labelledby="where-title">
  <div class="wrap where-grid">
    <header class="where-head">
      <h2 id="where-title" class="display display-md" data-split>{t.where.title}</h2>
      <p class="where-venue">{th.venue}</p>
      <p class="lede" data-reveal>{t.where.body}</p>
      <p class="where-meta" data-reveal>
        <span><Icon name="pin" /> {t.where.transport}</span>
      </p>
    </header>

    <!-- Hand-drawn map; directions go to the club's Google Maps listing. -->
    <div class="map frame sketch" data-reveal>
      <MapArt lang={lang} crop />
      <a class="btn map-directions" href={th.mapsUrl} target="_blank" rel="noopener">
        <Icon name="pin" />
        {t.thursdays.directions}
      </a>
      <p class="map-credit">{t.where.mapCredit}</p>
    </div>
  </div>
</section>

<style>
  .where-grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .where-head {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .where-venue {
    font-size: var(--text-xl);
    font-weight: 900;
    line-height: 1.2;
  }

  .where-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-weight: 700;
  }

  .where-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .where-meta :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }

  /* ---------- Map ---------- */
  .map {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--limestone);
    --sketch-color: var(--navy);
  }

  @media (min-width: 640px) {
    .map {
      aspect-ratio: 3 / 2;
    }
  }

  .map-directions {
    position: absolute;
    z-index: 2;
    top: 1rem;
    right: 1rem;
    width: auto;
  }

  .map-credit {
    position: absolute;
    z-index: 2;
    right: 0.75rem;
    bottom: 0.5rem;
    font-size: 0.6875rem;
    color: var(--limestone);
  }

  @media (min-width: 960px) {
    .where-grid {
      grid-template-columns: 1fr 1.25fr;
      align-items: center;
    }
  }
</style>
