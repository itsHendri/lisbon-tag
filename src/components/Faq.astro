---
import Icon from './Icon.astro';
import { useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<section id="faq" class="section theme-light faq" data-section aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <header class="faq-head">
      <h2 id="faq-title" class="display display-md" data-split>{t.faq.title}</h2>
    </header>

    <div class="faq-list" data-reveal>
      {
        t.faq.items.map((item) => (
          <details class="faq-item" name="faq">
            <summary>
              <span>{item.q}</span>
              <Icon name="plus" class="faq-icon" />
            </summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-grid {
    display: grid;
    gap: 2rem;
  }

  .faq-head {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  @media (min-width: 900px) {
    .faq-grid {
      grid-template-columns: 1fr 1.6fr;
      gap: 4rem;
    }
  }

  .faq-item {
    position: relative;
    padding-block: 0.25rem;
  }

  .faq-item::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -3px;
    height: 6px;
    background: currentColor;
    -webkit-mask: var(--rule-mask) center / 100% 100% no-repeat;
    mask: var(--rule-mask) center / 100% 100% no-repeat;
  }

  .faq-item:first-child::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -3px;
    height: 6px;
    background: currentColor;
    -webkit-mask: var(--rule-mask) center / 100% 100% no-repeat;
    mask: var(--rule-mask) center / 100% 100% no-repeat;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    padding-block: 0.9rem;
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  :global(.faq-icon) {
    flex: none;
    width: 1.4rem;
    height: 1.4rem;
    transition: transform 0.3s var(--ease-out);
  }

  .faq-item[open] :global(.faq-icon) {
    transform: rotate(45deg);
  }

  .faq-item p {
    padding-bottom: 1.25rem;
    color: var(--fg-muted);
    max-width: 60ch;
  }
</style>
