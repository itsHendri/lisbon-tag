---
import Photo from './Photo.astro';
import { useT, type Lang } from '../i18n';
import { photos } from '../data/photos';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<section id="about" class="section theme-light intro" data-section aria-labelledby="about-label">
  <div class="wrap intro-grid">
    <div class="intro-text">
      <h2 id="about-label" class="sr-only">{t.about.heading}</h2>
      <p class="statement" data-split>{t.about.statement}</p>
      <p class="lede" data-reveal>{t.about.body}</p>
    </div>

    <div class="collage">
      <figure class="collage-item c1 frame" data-tone="dark" data-parallax="0.06">
        <Photo photo={photos.intro1} lang={lang} sizes="(min-width: 900px) 30vw, 60vw" class="cover" />
      </figure>
      <figure class="collage-item c2 frame" data-tone="dark" data-parallax="0.14">
        <Photo photo={photos.intro2} lang={lang} sizes="(min-width: 900px) 20vw, 42vw" class="cover" />
      </figure>
      <figure class="collage-item c3 frame" data-tone="dark" data-parallax="0.1">
        <Photo photo={photos.intro3} lang={lang} sizes="(min-width: 900px) 24vw, 50vw" class="cover" />
      </figure>
      <figure class="collage-item c4 frame" data-tone="dark" data-parallax="0.18">
        <Photo photo={photos.intro4} lang={lang} sizes="(min-width: 900px) 18vw, 40vw" class="cover" />
      </figure>
    </div>
  </div>
</section>

<style>
  .intro-grid {
    display: grid;
    gap: clamp(3rem, 6vw, 6rem);
  }

  .intro-text {
    display: grid;
    gap: 1.5rem;
    max-width: 52rem;
  }

  .intro-text .statement {
    color: var(--fg);
  }

  /* A loose, overlapping collage on a 12-column grid. */
  .collage {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: clamp(2.5rem, 7vw, 5.5rem);
    gap: 0.75rem;
  }

  .collage-item {
    margin: 0;
    box-shadow: var(--shadow-lg);
  }

  .c1 {
    grid-column: 1 / 8;
    grid-row: 1 / 6;
  }
  .c2 {
    grid-column: 8 / 13;
    grid-row: 2 / 5;
  }
  .c3 {
    grid-column: 3 / 9;
    grid-row: 6 / 10;
  }
  .c4 {
    grid-column: 9 / 13;
    grid-row: 5 / 9;
  }

  @media (min-width: 900px) {
    .intro-grid {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
    .intro-text {
      align-self: start;
      position: sticky;
      top: 7rem;
    }
  }
</style>
