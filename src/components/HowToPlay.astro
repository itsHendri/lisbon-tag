---
import { Image } from 'astro:assets';
import TileFrame from './TileFrame.astro';
import { useT, type Lang } from '../i18n';
import { site } from '../data/site';
import ball from '../assets/brand/icon_rugby_ball_white.png';

// Rule icons from Phosphor (MIT, phosphoricons.com), bold weight.
// One per rule, in the same order as `how.rules` in the copy files.
import seven from '@phosphor-icons/core/assets/bold/users-three-bold.svg?raw';
import tag from '@phosphor-icons/core/assets/bold/hand-grabbing-bold.svg?raw';
import pass from '@phosphor-icons/core/assets/bold/timer-bold.svg?raw';
import defence from '@phosphor-icons/core/assets/bold/ruler-bold.svg?raw';
import turnover from '@phosphor-icons/core/assets/bold/swap-bold.svg?raw';
import backwards from '@phosphor-icons/core/assets/bold/arrow-u-up-left-bold.svg?raw';
import kick from '@phosphor-icons/core/assets/bold/sneaker-move-bold.svg?raw';
import noContact from '@phosphor-icons/core/assets/bold/prohibit-bold.svg?raw';
import tryLine from '@phosphor-icons/core/assets/bold/flag-checkered-bold.svg?raw';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

// Wrap each icon's shapes in the #rough-icon filter (Base.astro) so the edges
// wobble like the hand-drawn card strokes.
const rough = (svg: string) => svg.replace(/(<svg[^>]*>)/, '$1<g filter="url(#rough-icon)">').replace('</svg>', '</g></svg>');
const icons = [seven, tag, pass, defence, turnover, backwards, kick, noContact, tryLine].map(rough);

// First-timer steps: arrive ten minutes before kick-off, then play at kick-off.
const [h, m] = site.thursday.start.split(':').map(Number);
const arrive = `${String(Math.floor((h * 60 + m - 10) / 60)).padStart(2, '0')}:${String((h * 60 + m - 10) % 60).padStart(2, '0')}`;
const steps = t.how.first.steps.map((s, i) => ({ ...s, meta: i === 0 ? arrive : i === 2 ? site.thursday.start : s.meta }));
---

<section id="how" class="section theme-light how" data-section aria-labelledby="how-title">
  <div class="wrap">
    <header class="how-head">
      <h2 id="how-title" class="display display-md" data-split>{t.how.title}</h2>
      <p class="lede" data-reveal>{t.how.intro}</p>
    </header>

    <ol class="rules-list" data-reveal-stagger>
      {
        t.how.rules.map((rule, i) => (
          <li class="rule-card sketch">
            <span class="rule-icon" aria-hidden="true" set:html={icons[i]} />
            <span class="rule-title">{rule}</span>
          </li>
        ))
      }
    </ol>

  </div>
</section>

<!-- Never played? Full width in the azulejo frame, like the other dark sections. -->
<TileFrame as="section" class="first" aria-labelledby="first-title">
  <div class="wrap first-inner">
    <header class="first-head">
      <div class="first-title">
        <Image src={ball} alt="" width={160} format="webp" class="first-ball" />
        <h2 id="first-title" class="display display-md" data-split>{t.how.first.title}</h2>
      </div>
      <p class="first-intro" data-reveal>{t.how.first.intro}</p>
    </header>
    <ol class="first-steps" data-reveal-stagger>
      {
        steps.map((s, i) => (
          <li class:list={['step sketch', i === steps.length - 1 && 'step--go']}>
            <span class="step-top label">
              <span>{s.label}</span>
              <span>{s.meta}</span>
            </span>
            <h3 class="step-title">{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</TileFrame>

<style>
  .how-head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  /* ---------- Rules ---------- */
  .rules-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  /* Two columns on phones: an odd last card takes the full row. */
  @media (max-width: 899px) {
    .rule-card:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      min-height: 0;
    }
  }

  @media (min-width: 900px) {
    .rules-list {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
  }

  .rule-card {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 0.75rem;
    min-height: 9rem;
    padding: 1.1rem;
    background: var(--limestone);
    color: var(--navy);
  }

  .rule-icon {
    align-self: center;
    justify-self: start;
    width: clamp(2.5rem, 7vw, 3.5rem);
  }

  .rule-icon :global(svg) {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .rule-title {
    font-size: var(--text-lg);
    font-weight: 900;
    line-height: 1.15;
  }

  @media (min-width: 900px) {
    .rule-card {
      grid-template-columns: auto 1fr;
      grid-template-rows: auto;
      align-items: center;
      min-height: 7.5rem;
      padding: 1.5rem;
      column-gap: 1.25rem;
    }
    .rule-icon {
      align-self: center;
    }
    .rule-title {
      font-size: var(--text-xl);
    }
  }

  /* ---------- Never played: three steps, the last one filled ---------- */
  .first-inner {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .first-head {
    display: grid;
    gap: 1rem;
  }

  .first-title {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.25rem);
  }

  :global(.first-ball) {
    width: clamp(3.25rem, 7vw, 5.5rem);
    height: auto;
    flex: none;
  }

  .first-intro {
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.3;
  }

  .first-steps {
    display: grid;
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    background: var(--navy);
    color: var(--limestone);
    --sketch-inset: 0px;
    --sketch-w: 2.5px;
    --sketch-color: var(--limestone);
  }

  .step--go {
    background: var(--limestone);
    color: var(--navy);
    --sketch-color: var(--limestone);
  }

  .step-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .step-title {
    font-size: var(--text-xl);
    font-weight: 900;
    line-height: 1.1;
  }

  .step p {
    font-size: var(--text-lg);
    line-height: 1.45;
  }

  @media (min-width: 900px) {
    .first-head {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
    .first-intro {
      max-width: 22ch;
      text-align: right;
    }
    .first-steps {
      grid-template-columns: repeat(3, 1fr);
    }
    .step {
      min-height: 15rem;
    }
  }
</style>
