---
/**
 * "Add to calendar" opens Google Calendar with the weekly Thursday event
 * filled in (time, place and repeat), ready to save.
 */
import Icon from './Icon.astro';
import { useT, homeHref, type Lang } from '../i18n';
import { googleCalendarUrl } from '../data/calendar';

interface Props {
  lang: Lang;
  ghost?: boolean;
  class?: string;
}
const { lang, ghost = false, class: className } = Astro.props;
const t = useT(lang);
const google = googleCalendarUrl(t.calendar.summary, `${t.calendar.description}\n${new URL(homeHref(lang), Astro.site).href}`);
---

<a class:list={['btn', ghost && 'btn--ghost', className]} href={google} target="_blank" rel="noopener">
  <Icon name="calendar" />
  {t.thursdays.calendar}
</a>
